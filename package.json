{
  "name": "@transloadit/convex",
  "description": "Transloadit component for Convex",
  "version": "0.2.1",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transloadit/convex.git"
  },
  "license": "Apache-2.0",
  "author": "Transloadit",
  "keywords": [
    "convex",
    "component",
    "transloadit",
    "upload",
    "assembly",
    "tus",
    "media"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-package-json.ts",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "typecheck": "tsc --noEmit && yarn typecheck:example",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "verify": "yarn check && yarn verify:local",
    "verify:local": "node scripts/verify.ts --mode local",
    "verify:cloud": "node scripts/verify.ts --mode cloud",
    "verify:real": "yarn verify:cloud",
    "verify:browser": "yarn verify:local",
    "verify:convex": "yarn verify:cloud",
    "deploy:cloud": "node scripts/deploy-cloud.ts",
    "demo:cleanup": "node scripts/cleanup-demo.ts",
    "demo:media": "node scripts/generate-demo-media.ts",
    "example:dev": "yarn build && node ./node_modules/next/dist/bin/next dev example",
    "example:build": "yarn build && node ./node_modules/next/dist/bin/next build example",
    "example:start": "yarn build && node ./node_modules/next/dist/bin/next start example",
    "lint": "biome check .",
    "format": "biome format . --write",
    "check": "yarn format && yarn lint && yarn typecheck && yarn test",
    "prepack": "yarn build",
    "template:ensure": "node scripts/ensure-template.ts",
    "tunnel": "node scripts/start-webhook-tunnel.ts",
    "r2:lifecycle": "node scripts/ensure-r2-lifecycle.ts",
    "typecheck:example": "next typegen example && tsc --noEmit -p example/tsconfig.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@convex-dev/component-source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./lib": {
      "@convex-dev/component-source": "./src/component/lib.ts",
      "types": "./dist/component/lib.d.ts",
      "default": "./dist/component/lib.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    },
    "./convex.config": {
      "@convex-dev/component-source": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "default": "./dist/debug/index.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.24.8"
  },
  "dependencies": {
    "@transloadit/utils": "^4.8.1",
    "@transloadit/zod": "^4.4.0"
  },
  "devDependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@convex-dev/auth": "^0.0.95",
    "@edge-runtime/vm": "^5.0.0",
    "@fal-ai/client": "^1.10.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uppy/core": "^6.0.1",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/react": "^6.0.0",
    "@uppy/transloadit": "^6.0.0",
    "convex": "^1.45.0",
    "convex-test": "^0.0.58",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "resolutions": {
    "preact": "10.29.8"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
